# ============================================================
# Variáveis de ambiente - copie para .env e ajuste se necessário
# ============================================================

APP_NAME=Finaxis
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api

# Segurança
SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Persistência local (arquivos JSON)
# Caminhos relativos à pasta backend/ (ou absolutos)
DATA_DIR=data
BACKUP_DIR=backups

# CORS (lista de origens permitidas separadas por vírgula)
CORS_ORIGINS=["*"]

# Logs
LOG_LEVEL=INFO
LOG_DIR=logs

# Frontend
FRONTEND_DIR=frontend

# Recorrências
RECURRING_LOOKAHEAD_DAYS=60